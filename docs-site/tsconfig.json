{
  // Docs-site typecheck config (`vue-tsc --noEmit -p .`).
  //
  // The VitePress site carried ~1600 lines of TypeScript and Vue SFC that NO
  // typecheck in the repo ever compiled: `npm run typecheck` checks `src` only,
  // `tsconfig.dev.json` explicitly EXCLUDES `docs-site`, and `vitepress build`
  // transpiles without checking. A type error in the theme could therefore only
  // ever surface as a runtime fault on the deployed site.
  //
  // `.md` pages are not typechecked (they are content); this covers the VitePress
  // config, the custom theme's entry, and every `.vue` component it registers.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Vue SFCs compile to browser code; `config.ts` is Node (it reads the
    // TextMate grammar off disk at build time), so both lib sets are needed.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    // `.vitepress/theme/adr-data.js` and `examples-data.js` are GENERATED by
    // sync-docs.mjs (and gitignored), yet `config.ts` and `CompileSeam.vue` import
    // them. Checking the real emitted modules — rather than hand-writing an ambient
    // `declare module` that could quietly drift from what the generator writes — is
    // why the workspace `typecheck` script runs `sync` first and why `allowJs` is on.
    "allowJs": true,
    // NOTHING IS RELAXED. Unlike playground/tsconfig.json (which turns
    // `noUncheckedIndexedAccess` off), the theme passes under the root's full strict
    // set — `strict`, `noUncheckedIndexedAccess`, `noUnusedLocals`,
    // `noUnusedParameters` — because the first run found real faults with them on:
    // a dead `lastGoodSvg` accumulator in CompileSeam.vue and two unguarded
    // `tokens[idx]` reads. One constraint on any future fix in ArchLive.vue's
    // `playgroundUrl()`: test/share-codec.test.ts extracts that body and evaluates it
    // as PLAIN JS, so it must never carry TS-only syntax (`bytes[i]!`, `as`) — use a
    // `for…of` over the array instead of an index read.
    // Mirror the Vite alias in .vitepress/config.ts (`archlang` → the built core),
    // exactly as playground/tsconfig.json does: a repo-root `node_modules/archlang`
    // symlink points at the VS Code extension, so without this the bare specifier
    // resolves to the wrong package. Requires `npm run build` first.
    "baseUrl": ".",
    "paths": { "archlang": ["../dist/index.d.ts"] }
  },
  "include": [
    ".vitepress/config.ts",
    ".vitepress/theme/**/*.ts",
    ".vitepress/theme/**/*.d.ts",
    ".vitepress/theme/**/*.js",
    ".vitepress/theme/**/*.vue"
  ],
  "exclude": ["node_modules", ".vitepress/dist", ".vitepress/cache"]
}
