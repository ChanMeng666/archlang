# VitePress build output + cache
.vitepress/dist/
.vitepress/cache/

# Pages generated from canonical repo docs by sync-docs.mjs (do not edit/commit;
# the source of truth is docs/*.md and docs/adr/*.md).
reference.md
showcase.md
cli.md
furniture.md
analysis.md
axonometric.md
intent.md
errors.md
import.md
whats-new.md
spec.md
adr/0*.md
adr/index.md

# The ADR sidebar, generated from docs/adr/*.md by sync-docs.mjs and imported by
# .vitepress/config.ts (so the sidebar can never freeze behind the ADR directory).
.vitepress/theme/adr-data.js

# Sitemap <lastmod> dates for the GENERATED pages, written by sync-docs.mjs from each
# canonical source's git history and read by .vitepress/config.ts's transformItems.
.vitepress/lastmod.json

# Agent-gallery drawings, raw sources and the data module <AgentPlan> renders from,
# regenerated from docs/gallery/ by sync-docs.mjs.
public/gallery/
.vitepress/theme/gallery-data.js

# Example-gallery SVGs + the live-widget source data are regenerated from
# examples/*.arch by sync-docs.mjs.
public/examples/
.vitepress/theme/examples-data.js

# llms.txt map + full-context bundle, copied from the repo root by sync-docs.mjs.
public/llms.txt
public/llms-full.txt

# Machine-native artifacts + raw-markdown page copies, published at the site root
# by sync-docs.mjs (schema/gbnf from the repo root; the *.md are the unbannered
# canonical page bodies served at /<route>.md). Regenerated every build.
public/plan.schema.json
public/intent.schema.json
public/archlang.gbnf
public/reference.md
public/showcase.md
public/cli.md
public/furniture.md
public/analysis.md
public/axonometric.md
public/intent.md
public/errors.md
public/import.md
public/whats-new.md
public/spec.md

# The hand-written pages' raw copies (SITE_PAGES in sync-docs.mjs), served at /<route>.md.
public/index.md
public/guide.md
public/agents.md
public/examples.md
public/gallery.md
public/relational.md
public/embed.md
public/privacy.md
public/terms.md

# The self-contained <arch-plan> (core inlined, ~700 KB), built from the just-built dist/ by the
# `standalone` script on every dev/build. The slim /arch-plan.js beside it IS tracked (gen:arch-plan).
public/arch-plan.standalone.js

node_modules/
