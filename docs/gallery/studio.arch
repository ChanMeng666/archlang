# Studio flat, ~35 m² for one person.
# Main living/sleeping room (5.0 x 5.0 m) on the west; a 2.0 m wide column on the
# east holds the entrance hall (front door, north) above a separate bathroom.
# Kitchenette runs along the north wall of the main room; windows on the west
# and south walls of the main room, one small window in the bath.
plan "Studio 35" {
  units mm
  grid 50
  paper A3 landscape
  scale 1:50
  north up
  dims auto overall
  schedule rooms
  legend

  # Rooms (centreline dimensions): 25 + 4 + 6 = 35 m²
  room id=r_main at (0,0)       size 5000x5000 label "Living / Sleeping" uses living bedroom kitchen
  room id=r_hall at (5000,0)    size 2000x2000 label "Hall"              uses hall entry
  room id=r_bath at (5000,2000) size 2000x3000 label "Bath"              uses bath

  # Exterior shell as four named straight walls, plus two partitions.
  wall id=w_north exterior  thickness 200 { (0,0) (7000,0) }
  wall id=w_east  exterior  thickness 200 { (7000,0) (7000,5000) }
  wall id=w_south exterior  thickness 200 { (0,5000) (7000,5000) }
  wall id=w_west  exterior  thickness 200 { (0,0) (0,5000) }
  wall id=w_part  partition thickness 100 { (5000,0) (5000,5000) }
  wall id=w_hb    partition thickness 100 { (5000,2000) (7000,2000) }

  # Front door into the hall; hall -> main room; hall -> bath.
  door id=d_front on w_north at 6000 width 900 hinge near end swing into r_hall
  door id=d_main  on w_part  at 1000 width 900 hinge near start swing into r_main
  door id=d_bath  on w_hb    at 1000 width 800 hinge near end swing into r_bath

  # Windows: two for the main room, one for the bath.
  window id=win_w on w_west  at 50%  width 1500
  window id=win_s on w_south at 2500 width 1500
  window id=win_b on w_east  at 4400 width 600

  # Kitchenette along the north wall of the main room: sink, counter, stove, fridge.
  # (`offset` is the piece's centre along the wall.)
  furniture kitchen_sink against wall w_north offset 600  size 800x600 in r_main
  furniture counter      against wall w_north offset 1300 size 600x600 in r_main
  furniture stove        against wall w_north offset 1900 size 600x600 in r_main
  furniture fridge       against wall w_north offset 2600 size 700x650 in r_main

  # Living / sleeping furniture, clear of the door swing from the hall.
  furniture bed      in r_main anchor bottom-left  inset 300 size 1500x2000 label "Bed"
  furniture sofa     in r_main anchor bottom-right inset 300 size 2000x900  label "Sofa"
  furniture wardrobe in r_main anchor right        inset 300 size 600x1800  label "Wardrobe"

  # Bathroom: basin and WC on the east wall, shower in the south-west corner,
  # leaving the strip inside the door clear.
  furniture basin  against wall w_east offset 2500 size 600x450 in r_bath
  furniture wc     against wall w_east offset 3300 size 400x700 in r_bath
  furniture shower in r_bath anchor bottom-left flush size 900x900

  title {
    project "Studio flat, 35 m²"
    drawn_by "ArchLang"
    date "2026-10-09"
  }
}
