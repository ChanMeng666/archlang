plan "U-shaped courtyard house" {
  units mm
  grid 100
  north up
  paper A2 landscape
  scale 1:50
  dims auto all
  schedule rooms
  legend

  # Outer envelope: west arm x 0..4000, base y 0..6000, east arm x 10000..14000,
  # courtyard notch x 4000..10000 for y 6000..12000 open on the south side.

  # Exterior walls
  wall id=w_west exterior thickness 200 { (0,0) (0,12000) }
  wall id=w_north exterior thickness 200 { (0,0) (14000,0) }
  wall id=w_east exterior thickness 200 { (14000,0) (14000,12000) }
  wall id=w_se exterior thickness 200 { (14000,12000) (10000,12000) }
  wall id=w_sw exterior thickness 200 { (4000,12000) (0,12000) }
  wall id=w_court_e exterior thickness 200 { (10000,12000) (10000,6000) }
  wall id=w_court_base exterior thickness 200 { (10000,6000) (4000,6000) }
  wall id=w_court_w exterior thickness 200 { (4000,6000) (4000,12000) }

  # Interior partitions
  wall id=w_p_bed partition thickness 100 { (2900,0) (2900,12000) }
  wall id=w_b12 partition thickness 100 { (0,3500) (2900,3500) }
  wall id=w_b23 partition thickness 100 { (0,7000) (2900,7000) }
  wall id=w_bath partition thickness 100 { (0,10500) (2900,10500) }
  wall id=w_p_hc partition thickness 100 { (4000,0) (4000,6000) }
  wall id=w_p_hl partition thickness 100 { (5200,0) (5200,6000) }
  wall id=w_kit partition thickness 100 { (10000,0) (10000,6000) }
  wall id=w_ku partition thickness 100 { (10000,6000) (14000,6000) }

  # Rooms
  room id=r_b1 at (0,0) size 2900x3500 label "Bedroom 1" uses bedroom
  room id=r_b2 at (0,3500) size 2900x3500 label "Bedroom 2" uses bedroom
  room id=r_b3 at (0,7000) size 2900x3500 label "Bedroom 3" uses bedroom
  room id=r_bath at (0,10500) size 2900x1500 label "Bathroom" uses bath
  room id=r_corr at (2900,0) size 1100x12000 label "Corridor" uses circulation
  room id=r_hall at (4000,0) size 1200x6000 label "Entrance Hall" uses entry
  room id=r_living at (5200,0) size 4800x6000 label "Living Room" uses living
  room id=r_kit at (10000,0) size 4000x6000 label "Kitchen / Dining" uses kitchen
  room id=r_util at (10000,6000) size 4000x6000 label "Utility" uses utility

  # Openings
  door id=d_entry on w_north at 4600 width 1000
  opening id=o_hall_corr on w_p_hc at 1500 width 1000
  door id=d_living on w_p_hl at 3000 width 900 swing into r_living
  door id=d_b1 on w_p_bed at 1750 width 900 swing into r_corr
  door id=d_b2 on w_p_bed at 5250 width 900 swing into r_corr
  door id=d_b3 on w_p_bed at 8750 width 900 swing into r_corr
  door id=d_bath on w_p_bed at 11250 width 800 swing into r_corr
  opening id=o_liv_kit on w_kit at 3000 width 1200
  door id=d_util on w_ku at 2000 width 900 swing into r_util
  door id=d_back on w_se at 2000 width 900

  window id=win_b1 on w_west at 1750 width 1200
  window id=win_b2 on w_west at 5250 width 1200
  window id=win_b3 on w_west at 8750 width 1200
  window id=win_living on w_north at 7600 width 1800
  window id=win_kit on w_north at 12000 width 1200

  # Furniture
  furniture bed in r_b1 anchor bottom inset 300 size 1500x2000 label "Bed"
  furniture bed in r_b2 anchor bottom inset 300 size 1500x2000 label "Bed"
  furniture bed in r_b3 anchor bottom inset 300 size 1500x2000 label "Bed"
  furniture sofa in r_living anchor bottom inset 300 size 2400x900 label "Sofa"
  furniture counter in r_kit anchor right flush size 600x3000 label "Counter"
  furniture wc in r_bath anchor bottom-left inset 200 size 400x700 label "WC" rotate 180
  furniture basin in r_bath anchor top-left inset 200 size 500x400 label "Basin"
  title { project "U-shaped courtyard house" }
}
