# Two-bedroom flat, 10.0 m x 7.5 m = 75 m2.
# A central hall runs the full width; every room opens directly off it.
plan "Two-Bedroom Flat" {
  units mm
  grid 100
  north up
  paper A3 landscape
  scale 1:50
  dims auto all
  schedule rooms
  legend

  # North row: living + kitchen (3.3 m deep)
  strip right at (0,0) gap 0 height 3300 {
    room id=r_living  size 6200 label "Living Room" uses living
    room id=r_kitchen size 3800 label "Kitchen"     uses kitchen
  }

  # Central hall (1.4 m wide)
  room id=r_hall at (0,3300) size 10000x1400 label "Hall" uses hall

  # South row: bedrooms + bathroom (2.8 m deep)
  strip right at (0,4700) gap 0 height 2800 {
    room id=r_bed1 size 4700 label "Main Bedroom" uses bedroom
    room id=r_bed2 size 3300 label "Bedroom 2"    uses bedroom
    room id=r_bath size 2000 label "Bathroom"     uses bath
  }

  # Exterior shell
  wall id=w_north exterior thickness 200 { (0,0) (10000,0) }
  wall id=w_south exterior thickness 200 { (0,7500) (10000,7500) }
  wall id=w_west  exterior thickness 200 { (0,0) (0,7500) }
  wall id=w_east  exterior thickness 200 { (10000,0) (10000,7500) }

  # Partitions
  wall id=w_hall_n partition thickness 100 { (0,3300) (10000,3300) }
  wall id=w_hall_s partition thickness 100 { (0,4700) (10000,4700) }
  wall id=w_lk     partition thickness 100 { (6200,0) (6200,3300) }
  wall id=w_b1b2   partition thickness 100 { (4700,4700) (4700,7500) }
  wall id=w_b2ba   partition thickness 100 { (8000,4700) (8000,7500) }

  # Entrance into the hall
  door id=d_entry on w_west at 4000 width 1000 swing into r_hall

  # Every room opens off the hall
  door id=d_living  on w_hall_n at 3100 width 900 swing into r_living
  door id=d_kitchen on w_hall_n at 8100 width 900 swing into r_kitchen
  door id=d_bed1    on w_hall_s at 2350 width 900 swing into r_bed1
  door id=d_bed2    on w_hall_s at 6350 width 900 swing into r_bed2
  door id=d_bath    on w_hall_s at 9000 width 800 swing into r_bath

  # Windows
  window id=win_living  on w_north at 3100 width 2000
  window id=win_kitchen on w_north at 8100 width 1200
  window id=win_bed1    on w_south at 2350 width 1600
  window id=win_bed2    on w_south at 6350 width 1400
  window id=win_bath    on w_east  at 6100 width 600

  # Kitchen fixtures (clear of the door swing and the window)
  furniture stove        in r_kitchen anchor top-left  flush size 600x600 label "Stove"
  furniture kitchen_sink in r_kitchen anchor top-right flush size 600x600 label "Sink"
  furniture fridge       in r_kitchen anchor right     flush size 700x700 label "Fridge"

  # Bathroom fixtures (along the south end, clear of the door swing)
  furniture shower in r_bath anchor bottom-left  flush size 900x900 label "Shower"
  furniture wc     in r_bath anchor bottom-right flush size 400x700 label "WC"
  furniture basin  in r_bath anchor left         flush size 450x500 label "Basin"
  furniture sofa in r_living anchor right flush size 900x2000 rotate 90
  furniture coffee_table in r_living anchor right flush inset 1300 size 600x1000 rotate 90
  furniture bed in r_bed1 anchor bottom-left flush size 1500x2000 rotate 180
  furniture wardrobe in r_bed1 anchor top-right flush size 600x1800 rotate 90
  furniture bed in r_bed2 anchor bottom-right flush size 2000x1500 rotate 90
  furniture wardrobe in r_bed2 anchor top-left flush size 600x1800 rotate 270
  title { project "Two-Bedroom Flat" }
}
