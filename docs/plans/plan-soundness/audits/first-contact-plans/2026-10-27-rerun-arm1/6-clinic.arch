plan "Small Clinic" {
  units mm
  grid 100
  paper A3 landscape
  north up
  dims auto all

  room id=c1 at (0,0) size 3000x4500 label "Consulting 1" uses office
  room id=c2 right-of c1 size 3000x4500 label "Consulting 2" uses office
  room id=c3 right-of c2 size 3000x4500 label "Consulting 3" uses office
  room id=wc right-of c3 size 3000x4500 label "Accessible WC" uses wc
  room id=hall below c1 size 12000x1800 label "Corridor" uses hall
  room id=wait below hall align left size 6000x4000 label "Waiting / Reception" uses entry
  room id=staff right-of wait size 3000x4000 label "Staff Room" uses utility
  room id=store right-of staff size 3000x4000 label "Store" uses storage

  walls from rooms exterior 200 partition 100 { open between wait and hall width 1500 }

  door between c1 and hall at center width 900 swing into c1
  door between c2 and hall at center width 900 swing into c2
  door between c3 and hall at center width 900 swing into c3
  door between wc and hall at center width 900 swing into hall
  door between staff and hall at center width 900 swing into staff
  door between store and hall at center width 900 swing into store
  door on wait.bottom at 3000 from wait.left width 1200 swing into wait
  door on hall.right at center width 1000 swing into hall

  window on c1.top width 1200
  window on c2.top width 1200
  window on c3.top width 1200
  window on wc.top width 600 sill 1500
  window on wait.left width 1800
  window on staff.bottom width 1200
  window on store.bottom width 1000

  furniture reception_desk in wait anchor top-left inset 600 size 2000x700
  furniture sofa_l in wait anchor bottom-right inset 400 size 1800x900
  furniture bench in wait anchor bottom-left inset 400 size 1500x500

  furniture desk in c1 anchor top inset 400 size 1400x700
  furniture bed in c1 anchor bottom-right flush size 800x1900
  furniture basin against c1.left size 500x400
  furniture desk in c2 anchor top inset 400 size 1400x700
  furniture bed in c2 anchor bottom-right flush size 800x1900
  furniture basin against c2.left size 500x400
  furniture desk in c3 anchor top inset 400 size 1400x700
  furniture bed in c3 anchor bottom-right flush size 800x1900
  furniture basin against c3.left size 500x400

  furniture wc against wc.top
  furniture basin against wc.right

  furniture meeting_table in staff centered size 1600x900
  furniture locker against staff.right size 600x400
  furniture shelving in store anchor bottom flush size 2400x500

  title { project "Small Clinic" drawn_by "ArchLang" date "2026-10-27" number "A-01" revision "A" }
}
