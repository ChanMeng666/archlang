# A living room of about 7.8 m2 clear (2800 by 2800 mm between its wall faces; 9 m2 drawn), under the
# 10 m2 GB 50096-2011 5.2.2 gives a living room. The default ruleset holds a living room only to its
# generic 4 m2. This case and its twin are listed in ../check-set.json.
plan "Small living room" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (3000,0) (3000,3000) (0,3000) close }
  room id=r_living at (0,0) size 3000x3000 label "Living Room" uses living
  door id=d_entry at (1500,3000) width 900 wall shell
  window at (1500,0) width 1500 wall shell
}
