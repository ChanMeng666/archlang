plan "Three-Bed Family House" {
  units mm
  grid 100
  paper A3 landscape
  north up
  dims auto all
  height 2700

  room id=living at (0,0) size 4800x3400 label "Living" uses living
  room id=kitchen right-of living size 4800x3400 label "Kitchen / Dining" uses kitchen
  room id=utility right-of kitchen size 3000x3400 label "Utility" uses utility
  room id=garage below utility size 3000x5500 label "Garage" uses garage
  room id=hall at (0,3400) size 9600x1300 label "Entrance Hall" uses hall
  room id=master at (0,4700) size 3200x2800 label "Master Bedroom" uses bedroom
  room id=ensuite below master size 3200x1400 label "Ensuite" at (1900,7850) uses bath
  room id=bed2 at (3200,4700) size 2400x4200 label "Bedroom 2" uses bedroom
  room id=bed3 right-of bed2 align top size 2400x4200 label "Bedroom 3" uses bedroom
  room id=bath right-of bed3 align top size 1600x4200 label "Bathroom" at (8800,5600) uses bath

  walls from rooms exterior 250 partition 100

  door id=front on hall.left at center width 800 swing into hall
  door between hall and living at 1500 from start width 900 swing into living
  door between hall and kitchen at 2400 from start width 900 swing into kitchen
  door between kitchen and utility at 2800 from start width 800 swing into utility
  door between utility and garage at 1500 from start width 800 swing into utility
  door garage on garage.bottom at center width 2400
  door between hall and master at 2300 from start width 800 swing into master
  door between hall and bed2 at 1200 from start width 800 swing into bed2
  door between hall and bed3 at 1200 from start width 800 swing into bed3
  door between hall and bath at 800 from start width 800 swing into bath
  door between master and ensuite at 2600 from start width 800 swing into master

  window on living.top at center width 2000
  window on living.left at center width 1600
  window on kitchen.top at center width 2000
  window on utility.top at center width 900
  window on master.left at center width 1500
  window on ensuite.left at center width 600
  window on bed2.bottom at center width 1400
  window on bed3.bottom at center width 1400
  window on bath.bottom at center width 600

  furniture sofa in living centered size 2200x900
  furniture tv_unit against living.top
  furniture counter against kitchen.top offset 1200
  furniture kitchen_sink against kitchen.top offset 2600
  furniture stove against kitchen.top offset 3600
  furniture fridge against kitchen.right offset 800
  furniture washer against utility.right offset 600
  furniture laundry_sink against utility.right offset 1700
  furniture double_bed against master.left offset 1700 size 1400x1800
  furniture wc against ensuite.bottom offset 1500
  furniture basin against ensuite.bottom offset 2250
  furniture shower against ensuite.left offset 700
  furniture bed against bed2.bottom offset 1200
  furniture wardrobe against bed2.right offset 900 size 1200x600
  furniture bed against bed3.bottom offset 1200
  furniture wardrobe against bed3.left offset 900 size 1200x600
  furniture bathtub against bath.right offset 2900
  furniture wc against bath.left offset 1600
  furniture basin against bath.left offset 2500

  title { project "Three-Bed Family House" drawn_by "ArchLang" date "2026-10-26" number "H-01" revision "A" }
}
