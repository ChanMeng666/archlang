plan "Corner Cafe" {
  units mm
  grid 50
  paper A3 landscape
  scale 1:100
  north up
  dims auto all

  room id=seating at (0,0) size 7500x7500 label "Seating" uses dining
  room id=service right-of seating align top size 4500x2000 label "Counter"
  room id=kitchen below service size 4500x2500 label "Kitchen" uses kitchen
  room id=accwc below kitchen align left size 2000x3000 label "Accessible WC" uses wc
  room id=staffwc right-of accwc size 1200x3000 label "Staff WC" uses wc
  room id=store right-of staffwc size 1300x3000 label "Store" uses storage

  walls from rooms exterior 200 partition 100 {
    open between seating and service width 1500
  }

  # corner entrance (bottom-left) and glazing
  door id=entrance on seating.bottom at 1200 from start width 1200 swing outward
  window on seating.left at 3750 from start width 2400
  window on seating.top at 3750 from start width 3000
  window on seating.bottom at 5000 from start width 2400
  window on service.top at 2250 from start width 1500
  window on kitchen.right at 1700 from start width 900

  door between service and kitchen at 800 from start width 900 swing into kitchen
  door between seating and accwc at 1000 from start width 900 swing into accwc
  door between staffwc and store at 700 from start width 800 swing into staffwc
  door between kitchen and store at 650 from start width 800 swing into store
  door on store.right at center width 1000 swing outward

  # seating: 6 tables x 4 chairs = 24
  for c in 0..3 {
    for r in 0..2 {
      let x = 1200 + c * 1900
      let y = 1500 + r * 2600
      furniture table at (x, y) size 900x900
      furniture chair at (x + 50, y - 450) size 400x400
      furniture chair at (x + 450, y - 450) size 400x400
      furniture chair at (x + 50, y + 950) size 400x400 rotate 180
      furniture chair at (x + 450, y + 950) size 400x400 rotate 180
    }
  }

  furniture bar_counter in service anchor bottom-right flush size 2400x600
  furniture stove against kitchen.right offset 1700
  furniture counter against kitchen.top offset 2900
  furniture fridge against kitchen.top offset 3700
  furniture kitchen_sink against kitchen.bottom offset 900
  furniture wc against accwc.bottom
  furniture basin against accwc.right offset 1500
  furniture wc against staffwc.bottom
  furniture basin against staffwc.left offset 1000

  title { project "Corner Cafe" drawn_by "ArchLang" number "A-101" }
}
