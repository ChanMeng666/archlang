plan "Two-storey townhouse" {
  units mm
  grid 100
  paper A3 landscape
  north up
  dims auto all
  height 2700
  title { project "Townhouse, 2 x 55 m2" drawn_by "ArchLang" date "2026-10-27" number "TH-01" revision "A" }

  level 0 "Ground floor" {
    room id=living at (0,0) size 3500x5000 label "Living" uses living
    room id=kitchen below living size 3500x5000 label "Kitchen / Dining" uses kitchen
    room id=hall at (3500,0) size 2000x3000 label "Hall" uses hall
    room id=stairg below hall size 2000x4000 label "Stair" uses circulation
    room id=wc below stairg size 2000x3000 label "WC" uses wc
    walls from rooms exterior 200 partition 100 { open between living and kitchen }

    door on hall.top at center width 1000 swing into hall
    door between hall and living at center width 900 swing into living
    door between hall and stairg at center width 900 swing into stairg
    door between stairg and wc at center width 800 swing into wc
    window on living.left width 1600
    window on living.top width 1400 sill 900
    window on kitchen.left width 1400
    window on kitchen.bottom width 1800
    window on wc.right width 600 sill 1500

    stair id=st at (4000,4100) size 1000x1900 dir up
    furniture sofa in living anchor left flush size 900x2200
    furniture tv_unit in living anchor top flush size 1400x450
    furniture counter against kitchen.left offset 1500 size 2400x600
    furniture kitchen_sink against kitchen.left offset 3400 size 1200x600
    furniture fridge against kitchen.bottom offset 2000 size 700x700
    furniture table in kitchen anchor top-right inset 400 size 1800x900
    furniture wc against wc.bottom size 400x700
    furniture basin against wc.right offset 1500 size 450x350
  }

  level 1 "First floor" {
    room id=bed1 at (0,0) size 3500x5000 label "Bedroom 1" uses bedroom
    room id=bed2 below bed1 size 3500x5000 label "Bedroom 2" uses bedroom
    room id=bath at (3500,0) size 2000x3000 label "Bathroom" uses bath
    room id=landing below bath size 2000x7000 label "Landing" uses circulation
    walls from rooms exterior 200 partition 100
    door between landing and bath at center width 800 swing into bath
    door between landing and bed1 at center width 900 swing into bed1
    door between landing and bed2 at center width 900 swing into bed2
    window on bed1.left width 1600
    window on bed1.top width 1400
    window on bed2.left width 1400
    window on bed2.bottom width 1600
    window on bath.top width 800 sill 1200

    stair id=st at (4000,4100) size 1000x1900 dir down
    furniture double_bed in bed1 anchor bottom flush size 1600x2000
    furniture wardrobe against bed1.left offset 2500 size 1800x600
    furniture double_bed in bed2 anchor top flush size 1600x2000
    furniture wardrobe against bed2.left offset 2500 size 1800x600
    furniture bathtub against bath.right offset 1900 size 1700x750
    furniture wc against bath.top offset 700 size 400x700
    furniture basin against bath.left offset 2200 size 450x350
  }
}
