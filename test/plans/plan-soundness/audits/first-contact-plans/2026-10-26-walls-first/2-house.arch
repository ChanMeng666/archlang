plan "Three-bed family house" {
  units mm
  grid 100
  paper A3 landscape
  scale 1:100
  north up
  dims auto all
  schedule rooms

  room id=living at (0,0) size 6200x4800 label "Living" uses living
  room id=kitchen at (6200,0) size 3800x4800 label "Kitchen / Dining" uses kitchen
  room id=garage at (10000,0) size 3500x6000 label "Garage" uses garage
  room id=utility at (10000,6000) size 3500x3600 label "Utility" uses utility
  room id=bed2 at (0,4800) size 3300x2400 label "Bedroom 2" uses bedroom
  room id=bed3 at (0,7200) size 3300x2400 label "Bed 3" at (2500,8400) uses bedroom
  room id=hall at (3300,4800) size 1900x4800 label "Hall" uses entry
  room id=bath at (5200,4800) size 1800x2400 label "Bath" at (6100,5800) uses bath
  room id=ensuite at (7000,4800) size 3000x2400 label "Ensuite" uses bath
  room id=master at (5200,7200) size 4800x2400 label "Master" at (6600,7800) uses bedroom

  wall id=w_ext exterior thickness 200 { (0,0) (13500,0) (13500,9600) (0,9600) close }
  wall id=w_h partition thickness 100 { (0,4800) (10000,4800) }
  wall id=w_lk partition thickness 100 { (6200,0) (6200,4800) }
  wall id=w_x10 partition thickness 100 { (10000,0) (10000,9600) }
  wall id=w_gu partition thickness 100 { (10000,6000) (13500,6000) }
  wall id=w_x33 partition thickness 100 { (3300,4800) (3300,9600) }
  wall id=w_b23 partition thickness 100 { (0,7200) (3300,7200) }
  wall id=w_x52 partition thickness 100 { (5200,4800) (5200,9600) }
  wall id=w_x70 partition thickness 100 { (7000,4800) (7000,7200) }
  wall id=w_y72 partition thickness 100 { (5200,7200) (10000,7200) }

  # entrance and hall
  door at (4250,9600) width 1000 wall exterior swing inward
  door on w_h at 4250 width 900 swing into living
  opening on w_lk at 2400 width 2400

  # bedrooms
  door on w_x33 at 1200 width 800 swing into bed2
  door on w_x33 at 3600 width 800 swing into bed3
  door on w_x52 at 1200 width 800 swing into bath
  door on w_x52 at 3600 width 900 swing into master
  door on w_y72 at 2400 width 800 swing into ensuite

  # garage / utility
  door on w_x10 at 2400 width 900 swing into kitchen
  door on w_gu at 1750 width 800 swing into utility
  door garage at (13500,3000) width 2400 wall exterior
  door at (13500,7800) width 900 wall exterior swing inward

  window at (3000,0) width 2400 wall exterior
  window at (0,2400) width 1800 wall exterior
  window at (8100,0) width 1800 wall exterior
  window at (0,6000) width 1200 wall exterior
  window at (0,8400) width 1200 wall exterior
  window at (7600,9600) width 1800 wall exterior
  window at (11750,9600) width 900 wall exterior

  furniture sofa_l in living anchor bottom-left inset 600 size 2400x900
  furniture tv_unit in living anchor left flush size 400x1600
  furniture kitchen_sink at (6350,100) size 1200x600
  furniture counter at (7550,100) size 1000x600
  furniture stove at (8600,100) size 600x600
  furniture fridge at (9250,100) size 600x700
  furniture bed in bed2 anchor top-left flush size 1500x2000
