# G5 measurement fixture (issue 346): an exterior ring left open by a 1000 mm gap in the east
# wall. The rooms tile, the plan is otherwise clean; only the closure defect is present.
plan "Open exterior ring" {
  units mm
  grid 50
  wall id=n exterior thickness 200 { (0,0) (8000,0) }
  wall id=e exterior thickness 200 { (8000,0) (8000,2000) }
  wall id=e2 exterior thickness 200 { (8000,3000) (8000,5000) (0,5000) (0,0) }
  wall id=p partition thickness 100 { (4000,0) (4000,5000) }
  room id=a at (0,0) size 4000x5000 label "Living" uses living
  room id=b at (4000,0) size 4000x5000 label "Bedroom" uses bedroom
  door id=d_entry at (2000,5000) width 900 wall e2
  door at (4000,2500) width 800 wall p
  window at (2000,0) width 1500 wall n
  window at (6000,0) width 1500 wall n
}
