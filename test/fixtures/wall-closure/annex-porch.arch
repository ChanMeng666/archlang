# An open shell with a closed porch built off it: the west wall stops 1000 mm short of the corner.
# W_EXTERIOR_RING_OPEN names that gap, and the gross internal area is the porch's alone.
plan "Open shell, closed porch" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) (0,1000) }
  wall id=p partition thickness 100 { (4000,0) (4000,5000) }
  wall id=porch exterior thickness 200 { (8000,1500) (10000,1500) (10000,3500) (8000,3500) }
  room id=a at (0,0) size 4000x5000 label "Living" uses living
  room id=b at (4000,0) size 4000x5000 label "Bedroom" uses bedroom
  room id=c at (8000,1500) size 2000x2000 label "Porch" uses entry
  door id=d_entry at (9000,3500) width 900 wall porch
  door at (8000,2500) width 900 wall shell
  door at (2000,5000) width 900 wall shell
  door at (4000,2500) width 800 wall p
  window at (2000,0) width 1500 wall shell
  window at (6000,0) width 1500 wall shell
}
