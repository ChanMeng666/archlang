# A closed house and a `fence`: a fence is no wall, and closes and opens nothing.
plan "Fence" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
  wall id=p partition thickness 100 { (4000,0) (4000,5000) }
  room id=a at (0,0) size 4000x5000 label "Living" uses living
  room id=b at (4000,0) size 4000x5000 label "Bedroom" uses bedroom
  door id=d_entry at (2000,5000) width 900 wall shell
  door at (4000,2500) width 800 wall p
  window at (2000,0) width 1500 wall shell
  window at (6000,0) width 1500 wall shell
  fence id=f picket { (8000,0) (11000,0) (11000,5000) (8000,5000) }
}
