# A sheet carrying BOTH opt-in tables — the room schedule and the derived legend —
# on top of the full GB/T annotation stack (three-chain `dims auto`, a positioning-axis
# grid, a title block). Two wall materials and two fixture categories so the legend has
# something real to derive, and one deliberately UNLABELLED room so the schedule's
# id fallback is exercised. Test fixture only — the shipped examples stay table-free.
plan "Schedule Sheet" {
  units mm
  north up
  dims auto all
  schedule rooms
  legend

  axes {
    x at 0, 4000, 7000
    y at 0, 3000
  }

  wall id=shell exterior thickness 200 material brick {
    (0,0) (7000,0) (7000,3000) (0,3000) close
  }
  wall id=part partition thickness 100 {
    (4000,0) (4000,3000)
  }

  room id=living at (0,0) size 4000x3000 label "Living" uses living
  room id=bath at (4000,0) size 3000x3000 uses bath

  door on shell at 20% width 900
  door on part at 50% width 800
  window at (2000,0) width 1200

  furniture wc in bath anchor bottom-left flush size 400x700
  furniture basin in bath anchor bottom-right flush size 600x450

  title {
    project "Sheet Tables"
    drawn_by "ArchLang"
    date "2026-07-26"
  }
}
