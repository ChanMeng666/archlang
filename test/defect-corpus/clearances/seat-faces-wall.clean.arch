# class: clearances
# twin-of: seat-faces-wall
# origin: the same loveseat turned half a turn (`rotate 0`): its back is on the partition, its front faces the room
# expect: none
# fact: the loveseat's front (south, y = 2900) faces 2900 mm of living-room floor; its back to the partition is not judged
plan "Living room with a loveseat backed onto the partition" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (5000,0) (5000,6000) (0,6000) close }
  wall id=p partition thickness 100 { (0,2000) (5000,2000) }
  room id=r_hall at (0,0) size 5000x2000 label "Hall" uses hall
  room id=r_living at (0,2000) size 5000x4000 label "Living" uses living
  door id=d_entry at (2500,0) width 900 wall shell
  door id=d_living at (4200,2000) width 800 wall p swing into r_living
  window at (2500,6000) width 1500 wall shell
  furniture loveseat at (1000,2050) size 1500x850 label "Loveseat" in r_living
}
