# class: clearances
# origin: audits/archcanvas-public-examples.md CB2 ("the fridge is directly against the hob"; same template in courtyard, studio-loft, townhouse, family-house)
# expect: W_HOB_FRIDGE_GAP
# status: done
# fact: the stove spans x 1600-2200 and the fridge x 2200-2800 on the north wall: 0 mm between them
plan "Hob against the fridge" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (6000,0) (6000,4000) (0,4000) close }
  wall id=w_mid partition thickness 100 { (4000,0) (4000,4000) }
  room id=r_kitchen at (0,0) size 4000x4000 label "Kitchen" uses kitchen
  room id=r_living at (4000,0) size 2000x4000 label "Living Room" uses living
  door id=d_entry at (2000,4000) width 900 wall shell
  door id=d_mid at (4000,2000) width 800 wall w_mid
  window at (0,2000) width 1200 wall shell
  window at (6000,2000) width 1200 wall shell
  furniture counter against wall shell segment 0 offset 500 in r_kitchen
  furniture kitchen_sink against wall shell segment 0 offset 1200 in r_kitchen
  furniture stove against wall shell segment 0 offset 1900 in r_kitchen
  furniture fridge against wall shell segment 0 offset 2500 in r_kitchen
}
