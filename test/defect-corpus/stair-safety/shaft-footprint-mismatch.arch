# class: stair-safety
# origin: research/2026-10-18-furniture-and-multistorey.md B6 (card PS2.15: a same-id run whose footprints on adjacent
#   storeys do not overlap)
# expect: W_SHAFT_FOOTPRINT_MISMATCH
# status: done
# fact: stair st is x 500-1500 on level 1 and x 2500-3500 on level 2, both y 1200-4200: the footprints do not overlap,
#   so the flight climbed on level 1 arrives 1 m from the well drawn on level 2
plan "Stair drawn in two places" {
  units mm
  grid 50
  level 1 "Ground floor" {
    wall id=shell exterior thickness 200 { (0,0) (6000,0) (6000,6000) (0,6000) close }
    room id=hall at (0,0) size 6000x6000 label "Hall" uses hall
    door id=front at (3000,6000) width 1000 wall shell
    window at (3000,0) width 1500 wall shell
    stair id=st at (500,1200) size 1000x3000 dir up
  }
  level 2 "First floor" {
    wall id=shell exterior thickness 200 { (0,0) (6000,0) (6000,6000) (0,6000) close }
    wall id=w_p partition thickness 100 { (4000,0) (4000,6000) }
    room id=landing at (0,0) size 4000x6000 label "Landing" uses circulation
    room id=bed at (4000,0) size 2000x6000 label "Bedroom" uses bedroom
    door id=d_bed at (4000,5000) width 900 wall w_p swing into bed
    window at (5000,0) width 1200 wall shell
    stair id=st at (2500,1200) size 1000x3000 dir down
  }
}
