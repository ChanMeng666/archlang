# class: stair-safety
# origin: audits/showcase-and-examples.md X9 (examples/two-storey.arch L2: the void is at the head of the stair; reduced)
# expect: W_STAIR_HEAD_VOID
# status: done
# fact: the flight (x 100-1000, y 1500-4100) is entered at its south end on level 1 and arrives at its north
#   end y=1500 on level 2, where void gallery spans x 100-1000, y 200-1300: 200 mm past the top tread
plan "Void at the stair head" {
  units mm
  grid 50
  level 1 "Ground floor" {
    wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,7000) (0,7000) close }
    wall id=hall_w partition thickness 100 { (2200,0) (2200,7000) }
    room id=hall at (0,0) size 2200x7000 label "Hall" uses hall
    room id=living at (2200,0) size 5800x7000 label "Living" uses living
    door id=front at (0,5500) width 1000 wall shell
    door id=d_living at (2200,1800) width 900 wall hall_w swing into living
    window at (5000,0) width 1800 wall shell
    stair id=stair at (100,1500) size 900x2600 dir up
  }
  level 2 "First floor" {
    wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,7000) (0,7000) close }
    wall id=hall_w partition thickness 100 { (2200,0) (2200,7000) }
    room id=landing at (0,0) size 2200x7000 label "Landing" uses circulation
    room id=bed1 at (2200,0) size 5800x7000 label "Bedroom 1" uses bedroom
    door id=d_bed1 at (2200,1800) width 900 wall hall_w swing into bed1
    window at (5000,0) width 1500 wall shell
    stair id=stair at (100,1500) size 900x2600 dir down
    void id=gallery at (100,200) size 900x1100
  }
}
