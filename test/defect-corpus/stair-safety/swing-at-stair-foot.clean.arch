# class: stair-safety
# twin-of: swing-at-stair-foot
# origin: audits/2026-10-18-first-contact.md T1 with d_front swinging out
# expect: none
# fact: d_front swings out: its leaf sweeps y 4000-4800 outside the shell, and nothing swings over the stair or within
#   400 mm of its bottom step (y 2900)
plan "Front door swinging at the foot of the stair" {
  units mm
  grid 50
  wall id=shell exterior thickness 250 { (0,0) (5500,0) (5500,4000) (0,4000) close }
  wall id=w_v partition thickness 100 { (2200,0) (2200,4000) }
  room id=r_hall at (0,0) size 2200x4000 label "Hall" uses hall
  room id=r_liv at (2200,0) size 3300x4000 label "Living" uses living
  door id=d_front at (700,4000) width 800 wall shell hinge near end swing out
  door id=d_liv at (2200,1500) width 900 wall w_v swing into r_liv
  window at (3800,4000) width 1800 wall shell
  window at (3800,0) width 1800 wall shell
  stair id=st at (150,200) size 800x2700 dir up
}
