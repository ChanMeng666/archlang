plan "paper" {
  units mm
  paper A3 landscape
  level 1 "Ground" {
    wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
    room id=hall at (0,0) size 3000x5000 label "Hall" uses hall
    room id=live at (3000,0) size 5000x5000 label "Living" uses living
    stair id=st at (300,3800) size 2400x900 dir up
    void id=v at (300,300) size 1000x1000
    keep min clear live 4500
    keep align hall.right live.left
  }
  level 2 "First" {
    wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
    room id=hall at (0,0) size 3000x5000 label "Landing" uses hall
    room id=bed at (3000,0) size 5000x5000 label "Bed" uses bedroom
    stair id=st at (300,3800) size 2400x900 dir up
    void id=v at (300,300) size 1000x1000
    keep min clear bed 4800 soft
  }
  level 3 "Second" {
    wall id=shell exterior thickness 200 { (0,0) (8000,0) (8000,5000) (0,5000) close }
    room id=hall at (0,0) size 3100x5000 label "Attic landing" uses hall
    room id=loft at (3100,0) size 4900x5000 label "Loft"
    stair id=st at (300,3800) size 2400x900 dir down
    void id=v at (300,300) size 1000x1000
  }
  keep stacked st on levels 1 2 3
  keep stacked hall on levels 1 2 3 soft
  keep stacked v on levels 1 3 advisory
}
