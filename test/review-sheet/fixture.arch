# The review-sheet fixture (plan-soundness PS5.4, `test/cli-preview-review.test.ts`): five known
# warnings, one per kind of thing the sheet rings: a door at a junction, a WC too close to a side
# wall, a furniture overlap, a room no door enters and an open leaf across another doorway.
plan "Review sheet fixture" {
  units mm
  grid 50
  wall id=shell exterior thickness 200 { (0,0) (10000,0) (10000,6000) (0,6000) close }
  wall id=p_west partition thickness 100 { (3000,0) (3000,6000) }
  wall id=p_bed partition thickness 100 { (0,3000) (3000,3000) }
  wall id=p_east partition thickness 100 { (7000,0) (7000,6000) }
  wall id=p_store partition thickness 100 { (7000,3000) (10000,3000) }
  room id=r_bed at (0,0) size 3000x3000 label "Bedroom" uses bedroom
  room id=r_bath at (0,3000) size 3000x3000 label "Bathroom" uses bath
  room id=r_hall at (3000,0) size 4000x6000 label "Hall" uses hall
  room id=r_store at (7000,0) size 3000x3000 label "Store" uses storage
  room id=r_living at (7000,3000) size 3000x3000 label "Living Room" uses living
  door id=d_front at (3700,0) width 900 wall shell hinge near start swing into r_hall
  door id=d_bed at (3000,650) width 800 wall p_west swing into r_bed
  door id=d_bath at (3000,4500) width 800 wall p_west swing into r_bath
  door id=d_living at (7000,4500) width 900 wall p_east swing into r_living
  door id=d_garden at (7550,6000) width 900 wall shell
  window at (1500,0) width 1200 wall shell
  window at (9200,6000) width 1000 wall shell
  furniture wc against wall shell segment 3 offset 300 in r_bath
  furniture bathtub against wall shell segment 3 offset 1500 in r_bath
  furniture sofa at (8900,3500) size 900x2000 in r_living
  furniture coffee_table at (8100,4000) size 1000x600 in r_living
  furniture basin in r_bath anchor top flush size 600x450
}
