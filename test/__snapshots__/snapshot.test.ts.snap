exports[`golden SVG snapshots > renders two-storey.arch as one page per level > two-storey.arch L2 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape" width="420mm" height="297mm" viewBox="-6500 -3225 21000 14850" font-family="Helvetica, Arial, sans-serif">
