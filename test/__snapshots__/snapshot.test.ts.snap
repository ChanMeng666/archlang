<polygon points="2200,0 8000,0 8000,3600 2200,3600" fill="#fbfaf7"/>
<polygon points="2200,3600 8000,3600 8000,7000 2200,7000" fill="#fbfaf7"/>
</g>
<g id="A-FURN" inkscape:groupmode="layer" inkscape:label="A-FURN">
<polygon points="6100,400 7600,400 7600,2400 6100,2400" fill="#f4f2ee" stroke="#a8a29a" stroke-width="9"/>
<text x="6850" y="1400" font-size="100" fill="#9a948c" text-anchor="middle" dominant-baseline="central">Double</text>
<polygon points="4600,4600 5600,4600 5600,6600 4600,6600" fill="#f4f2ee" stroke="#a8a29a" stroke-width="9"/>
