exports[`golden SVG snapshots > renders two-storey.arch as one page per level > two-storey.arch L2 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape" width="420mm" height="297mm" viewBox="-6500 -3225 21000 14850" font-family="Helvetica, Arial, sans-serif">
<defs><pattern id="poche" patternUnits="userSpaceOnUse" width="60" height="60" patternTransform="rotate(45)"><rect width="60" height="60" fill="#e9e4db"/><line x1="0" y1="0" x2="0" y2="60" stroke="#b9b1a4" stroke-width="6.3"/></pattern></defs>
<rect x="-6500" y="-3225" width="21000" height="14850" fill="#ffffff"/>
<g id="A-FLOR" inkscape:groupmode="layer" inkscape:label="A-FLOR">
<polygon points="0,0 2200,0 2200,4600 0,4600" fill="#fbfaf7"/>
