exports[`golden SVG snapshots > renders gallery-l.arch deterministically 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape" width="420mm" height="297mm" viewBox="-15381.87 -6910 42000 29700" font-family="Helvetica, Arial, sans-serif">
