# Imports demo (v0.10): pull components from the standard libraries under lib/.
# Paths resolve relative to this file via the World seam.
plan "Imports Demo" {
  units mm
  grid 50
  scale 1:50
  north up

  import "lib/furniture.arch": bed, sofa, stove
  import "lib/doors.arch": single, glazing

  wall exterior thickness 200 { (0,0) (5000,0) (5000,4000) (0,4000) close }

  room id=r_main at (0,0) size 5000x4000 label "Studio"

  bed(3000, 300)
  # The sofa clears the front door's swing. `single(2000, 4000, 1000)` hangs its leaf on
  # the x=2500 jamb of the south wall and needs 1000 mm of clear radius; at the obvious
  # y=2800 the sofa's near corner sits 361 mm away and `W_SWING_OBSTRUCTED` fires. The
  # component takes a position and nothing else, so the piece moves rather than the leaf
  # — and the warning's own `file` is `lib/doors.arch`, because that is where the `door`
  # statement is written, while the element to move lives here.
  sofa(300, 2000)
  stove(300, 300)

  single(2000, 4000, 1000)
  glazing(4000, 0, 1200)

  # Outside-face overall width (5000 room grid + half the 200 shell each end = 5200).
  dim faces (0,4000)->(5000,4000) offset 600
}
