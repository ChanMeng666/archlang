# Live eval output is ephemeral (moves with the model/day) — the committed
# scorecard is eval/results.md; the live headline lives in eval/live-baseline.json.
eval/results.live.md
# L2 loop-vs-resampling output is ephemeral too (per-run, model/day-dependent).
eval/results.l2.md
eval/results.l2.json
# Generated dataset artifacts (HF-only; the generator + seed are the committed source).
dataset/out/
# local env & agent-session artifacts
.env
.env.*

# Wrangler's local state/cache, written beside each site's wrangler.jsonc by
# `wrangler deploy` / `wrangler dev`. The workspace .gitignore files that used to
# ignore Vercel's `.vercel` equivalent were removed in the Cloudflare migration;
# this is the replacement, kept at the root so it covers both sites.
.wrangler/
.claude/settings.local.json
.superpowers/
.agents/
.codex/
