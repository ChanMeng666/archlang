# FAITHFUL reference for `min-bedroom-flat` (a SATISFIABLE brief).
#
# R1 bedroom >= 13 m² (this one is 14.4), R2 total <= 45 m² (this one is 40.0),
# R3 exactly 3 rooms. Every stated number is honoured with room to spare — which is the
# point: the brief is satisfiable, so refusing it is its own failure.
plan "Min Bedroom Flat (faithful)" {
  units mm
  grid 50
  north up

  wall exterior  thickness 200 { (0,0) (10000,0) (10000,4000) (0,4000) close }
  wall partition thickness 100 { (5000,0) (5000,4000) }
  wall partition thickness 100 { (8600,0) (8600,4000) }

  room id=r_live at (0,0)    size 5000x4000 label "Living / Kitchen" uses living kitchen
  room id=r_bed  at (5000,0) size 3600x4000 label "Bedroom"          uses bedroom
  room id=r_bath at (8600,0) size 1400x4000 label "Bathroom"         uses bath

  door id=d_main at (2500,4000) width 900 wall exterior  hinge left  swing in
  door id=d_bed  at (5000,2000) width 800 wall partition hinge right swing in
  door id=d_bath at (8600,2000) width 800 wall partition hinge right swing in

  window at (2500,0) width 1500 wall exterior
  window at (6800,0) width 1500 wall exterior
}
