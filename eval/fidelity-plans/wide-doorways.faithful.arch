# FAITHFUL reference for `wide-doorways` (a SATISFIABLE brief).
#
# R1 every doorway >= 1000 mm (all three are exactly 1000), R2 wet room >= 5 m² (6.4),
# R3 exactly 3 rooms, R4 the bedroom has a window (the 1500 mm one on its north wall).
plan "Wide Doorways (faithful)" {
  units mm
  grid 50
  north up

  wall exterior  thickness 200 { (0,0) (9600,0) (9600,4000) (0,4000) close }
  wall partition thickness 100 { (5000,0) (5000,4000) }
  wall partition thickness 100 { (8000,0) (8000,4000) }

  room id=r_live at (0,0)    size 5000x4000 label "Living / Kitchen" uses living kitchen
  room id=r_bed  at (5000,0) size 3000x4000 label "Bedroom"          uses bedroom
  room id=r_wet  at (8000,0) size 1600x4000 label "Wet Room"         uses bath

  door id=d_main at (2500,4000) width 1000 wall exterior  hinge left  swing in
  door id=d_bed  at (5000,2000) width 1000 wall partition hinge right swing in
  door id=d_wet  at (8000,2000) width 1000 wall partition hinge right swing in

  window at (2000,0) width 1500 wall exterior
  window at (6500,0) width 1500 wall exterior
}
