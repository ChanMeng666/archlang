# COUNTER-EXAMPLE for `min-bedroom-flat`.
#
# Same shell, same room count, same 40.0 m² total — the bedroom alone was shrunk from
# 14.4 m² to 11.4 m², under the stated 13 m² floor, with the 3 m² handed to the bathroom
# so nothing else moves. A repair loop that could not fit the bedroom took the cheap way
# out and rewrote the requirement to "at least 11". Committed so the detector can be
# proved to NAME R1 and only R1.
plan "Min Bedroom Flat (laundered)" {
  units mm
  grid 50
  north up

  wall exterior  thickness 200 { (0,0) (10000,0) (10000,4000) (0,4000) close }
  wall partition thickness 100 { (5000,0) (5000,4000) }
  wall partition thickness 100 { (7850,0) (7850,4000) }

  room id=r_live at (0,0)    size 5000x4000 label "Living / Kitchen" uses living kitchen
  room id=r_bed  at (5000,0) size 2850x4000 label "Bedroom"          uses bedroom
  room id=r_bath at (7850,0) size 2150x4000 label "Bathroom"         uses bath

  door id=d_main at (2500,4000) width 900 wall exterior  hinge left  swing in
  door id=d_bed  at (5000,2000) width 800 wall partition hinge right swing in
  door id=d_bath at (7850,2000) width 800 wall partition hinge right swing in

  window at (2500,0) width 1500 wall exterior
  window at (6400,0) width 1500 wall exterior
}
