# COUNTER-EXAMPLE for the infeasible brief `capped-wet-room`.
#
# R1 caps every room at 5 m²; R2 puts a floor of 6 m² under the wet room. No plan holds
# both. This plan honours R2 (a 6 m² wet room) and R3 (exactly 3 rooms) and silently
# moves R1: its largest room is 6 m², not 5. Committed so the detector can be proved to
# NAME R1 — and, separately, to demonstrate that the intent channel cannot see this at
# all: `Intent` has no plan-wide per-room area band, so R1 is unrepresentable there.
plan "Capped Wet Room (laundered)" {
  units mm
  grid 50
  north up

  wall exterior  thickness 200 { (0,0) (7250,0) (7250,2000) (0,2000) close }
  wall partition thickness 100 { (3000,0) (3000,2000) }
  wall partition thickness 100 { (5000,0) (5000,2000) }

  room id=r_wet  at (0,0)    size 3000x2000 label "Wet Room" uses bath
  room id=r_hall at (3000,0) size 2000x2000 label "Hall"     uses hall
  room id=r_bed  at (5000,0) size 2250x2000 label "Bedroom"  uses bedroom

  door id=d_main at (4000,2000) width 900 wall exterior  hinge left  swing in
  door id=d_wet  at (3000,1000) width 800 wall partition hinge right swing in
  door id=d_bed  at (5000,1000) width 800 wall partition hinge right swing in

  window at (1000,0) width 1200 wall exterior
  window at (6000,0) width 1000 wall exterior
}
