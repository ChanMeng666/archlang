# COUNTER-EXAMPLE for `wide-doorways` — and the sharpest case in this slice.
#
# Byte-for-byte the faithful plan except that the wet-room door is 900 mm, under the
# stated 1000 mm floor. Every room, every area and every room count is untouched, so the
# INTENT CHANNEL PASSES THIS PLAN: `Intent` has no door-width vocabulary at all, which
# means the requirement was never in the contract to be weakened — it was invisible from
# the start. Only the fidelity check, which measures the brief's stated numbers against
# `describe()` facts directly, catches it. Committed so that blindness is a test, not a
# claim.
plan "Wide Doorways (laundered)" {
  units mm
  grid 50
  north up

  wall exterior  thickness 200 { (0,0) (9600,0) (9600,4000) (0,4000) close }
  wall partition thickness 100 { (5000,0) (5000,4000) }
  wall partition thickness 100 { (8000,0) (8000,4000) }

  room id=r_live at (0,0)    size 5000x4000 label "Living / Kitchen" uses living kitchen
  room id=r_bed  at (5000,0) size 3000x4000 label "Bedroom"          uses bedroom
  room id=r_wet  at (8000,0) size 1600x4000 label "Wet Room"         uses bath

  door id=d_main at (2500,4000) width 1000 wall exterior  hinge left  swing in
  door id=d_bed  at (5000,2000) width 1000 wall partition hinge right swing in
  door id=d_wet  at (8000,2000) width  900 wall partition hinge right swing in

  window at (2000,0) width 1500 wall exterior
  window at (6500,0) width 1500 wall exterior
}
