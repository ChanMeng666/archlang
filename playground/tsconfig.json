{
  // Playground app typecheck config. Extends the core's compiler options but
  // targets a Vite/browser ESM bundle: Bundler module resolution, `vite/client`
  // ambient types (for `?raw` imports), and DOM.Iterable so NodeList/Map/Set
  // spread & for..of work. noUncheckedIndexedAccess is deliberately relaxed here
  // (the DOM/regex-heavy UI code reads indices it has already length-checked).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowJs": true,
    "noUncheckedIndexedAccess": false,
    "declaration": false,
    "noEmit": true,
    // Mirror the Vite alias (`archlang` → the built core): a repo-root
    // `node_modules/archlang` symlink points at the vscode extension, so without
    // this TS would resolve the bare specifier to the wrong package.
    "baseUrl": ".",
    "paths": { "archlang": ["../dist/index.d.ts"] }
  },
  // `test` is included so the playground's own vitest suites are typechecked too —
  // they were previously invisible to every typecheck in the repo. `e2e/` is NOT
  // here: the Playwright specs run in Node (`node:fs/promises`, `Buffer`) under a
  // different lib/types set, so they get their own `tsconfig.e2e.json`, which the
  // workspace `typecheck` script runs straight after this one.
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist", "e2e"]
}
