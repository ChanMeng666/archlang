{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ChanMeng666/archlang-mcp",
  "title": "ArchLang",
  "description": "Floor plans as code: compile, lint and repair ArchLang (.arch) floor plans to SVG, DXF and PDF.",
  "version": "0.2.52",
  "repository": {
    "url": "https://github.com/ChanMeng666/archlang",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "websiteUrl": "https://archlang.uk",
  "icons": [
    {
      "src": "https://archlang.uk/brand/archlang-icon-app-plum.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    },
    {
      "src": "https://archlang.uk/brand/archlang-apple-touch.png",
      "mimeType": "image/png",
      "sizes": ["180x180"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@chanmeng666/archlang-mcp",
      "version": "0.2.52",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.archlang.uk/mcp"
    }
  ]
}
