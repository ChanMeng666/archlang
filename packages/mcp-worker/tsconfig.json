{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "baseUrl": ".",
    // The Worker bundles THIS checkout's core (scripts/build.mjs aliases it to ../../dist), so the
    // types come from the same build: `npm run build` at the root first, as for typecheck:all.
    "paths": {
      "@chanmeng666/archlang": ["../../dist/index.d.ts"],
      "@chanmeng666/archlang/link": ["../../dist/cli/link.d.ts"],
      "@chanmeng666/archlang/share": ["../../dist/share.d.ts"]
    }
  },
  "include": ["src", "test"]
}
