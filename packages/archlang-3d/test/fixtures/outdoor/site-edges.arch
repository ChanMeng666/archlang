# The site's edge cases (review R1 of PR #701): a lawn under the whole building, surfaces over it,
# a fence with a repeated last point, a closed fence of two points, a fence of one repeated point,
# and a terrace and a fence on the upper storey.
plan "site-edges" {
  units mm
  grid 50
  north up
  level 1 "Ground" {
    wall id=shell exterior thickness 200 { (0,0) (6000,0) (6000,4000) (0,4000) close }
    room id=r at (0,0) size 6000x4000
    outdoor id=under lawn at (-3000,-3000) size 12000x10000
    outdoor id=pv paving at (6500,500) size 2000x2000
    outdoor id=tri water polygon (-2500,5000) (1500,5000) (-500,6500)
    fence id=diag picket { (-2800,-2800) (8500,-1500) (8500,-1500) }
    fence id=two post { (7000,3000) (8800,3000) close }
    fence id=zz panel { (-2800,7000) (-2800,7000) }
  }
  level 2 "Upper" {
    wall id=shell exterior thickness 200 { (0,0) (6000,0) (6000,4000) (0,4000) close }
    room id=r2 at (0,0) size 6000x4000
    outdoor id=terr paving at (6000,0) size 2500x4000
    fence id=up picket { (6000,0) (8500,0) (8500,4000) (6000,4000) }
  }
}
