{
  "name": "@chanmeng666/archlang-3d",
  "version": "0.0.0",
  "private": true,
  "description": "A downstream reader of a resolved ArchLang plan: adapts it to a plan-aligned Scene3D. ArchLang itself draws plans; this package is separate and unpublished.",
  "license": "MIT",
  "author": "Chan Meng <chanmeng.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChanMeng666/archlang.git",
    "directory": "packages/archlang-3d"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./node": "./src/node.ts"
  },
  "files": [
    "src",
    "THIRD_PARTY_NOTICES",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "archlang3d": "tsx src/cli/main.ts",
    "notices": "tsx scripts/licence-gate.ts --write"
  },
  "peerDependencies": {
    "@chanmeng666/archlang": "^1.43.1"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "earcut": "^3.2.4",
    "esbuild": "^0.28.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright-core": "1.64.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "ajv": "^8.20.0",
    "typescript": "^5.7.2"
  }
}
